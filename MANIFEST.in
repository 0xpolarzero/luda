include requirements.lock requirements-browser.lock uv.lock build-requirements.in build-requirements.lock
recursive-include docs *.md *.json
recursive-include scripts *.py *.sh *.js *.mjs
recursive-include skills *.md
recursive-include tests *.py *.sh *.html *.js *.json *.md
recursive-include tests/evidence/browser-download-cleanup *.log
recursive-include tests/evidence/browser-clipboard-guardian *.log
recursive-include tests/evidence/agent-rich-first-attempt *.gz
recursive-include tests/evidence/matrix-xvfb-startup *.log
recursive-include tests/evidence/browser-permission *.log *.png
prune tests/tools/codex-cli/node_modules
prune tests/fixtures/rich-editor/node_modules
prune tests/fixtures/owned-rich-editor/node_modules
prune tests/fixtures/pm-selection/node_modules
prune tests/fixtures/agent-rich-clipboard/node_modules

include .mcp.json
recursive-include .codex-plugin *.json
recursive-include integrations *.py *.json *.md *.patch *.mjs
