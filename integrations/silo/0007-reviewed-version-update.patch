+pub async fn update_desktop_codex(app: AppHandle, window: tauri::Window, workspace: String, codex_executable: String, codex_home: String, confirmation: Option<String>) -> Result<Value,String> {
+    crate::desktop_viewer::require_workspace(&window,&workspace)?;
+    tauri::async_runtime::spawn_blocking(move||{
+        crate::runtime::shutdown::ensure_accepting_operations()?;
+        if crate::remote_access::target(&workspace)?.is_some(){return Err("Codex updates currently support local VMs only.".into())}
+        let executable=owned(Path::new(&codex_executable),false)?;let home=owned(Path::new(&codex_home),true)?;let _lock=profile_lock(&home)?;
+        let (paths,machine)=crate::desktop::machine(&app,&workspace)?;
+        let id=uuid::Uuid::parse_str(machine.id()).map_err(|_|fail())?.to_string();let target=home.join("silo-desktop-tools").join(&id);let market=target.join("marketplace");
+        let alias=crate::editor::verify_private_transport(&paths,&workspace,&target.join("transport"))?;
+        let skill=crate::desktop::guest(&crate::runtime::ProcessRunner,&paths,&workspace,"head -c 262145 /opt/luda/current/skills/luda/SKILL.md",Duration::from_secs(5),false).map_err(|_|"The installed guest skill could not be read.".to_string())?;
+        if skill.as_bytes()!=SKILL{return Err("Guest skill does not match this reviewed Silo integration.".into())}
+        let stat=fs::metadata(&executable).map_err(|_|fail())?;
+        let context=json!({"executable":executable,"device":stat.dev(),"inode":stat.ino(),"mtime":stat.mtime(),"mtimeNsec":stat.mtime_nsec(),"size":stat.len(),"workspace":workspace,"vmId":id,"alias":alias});
+        let mut runner=|args:&[&str]|cli(&executable,&home,args);
+        let plan=plan_update(&home,&market,&context,SKILL,&mut runner)?;
+        if plan.old["vmId"]!=id{return Err(fail())}
+        if let Some(confirmation)=confirmation {
+            confirm_update(&home,&market,plan,&confirmation,SKILL,&mut runner)
+        }else{
+            Ok(json!({"state":"preview","token":plan.token,"vmId":id,"serverName":plan.new["serverName"],"oldVersion":plan.old["version"],"newVersion":plan.new["version"],"oldSkillSha256":plan.old["skillSha256"],"newSkillSha256":plan.new["skillSha256"],"runtimeVerified":false}))
+        }
+    }).await.map_err(|_|"Codex update worker failed; inspect the selected profile.".to_string())?
+}
 
