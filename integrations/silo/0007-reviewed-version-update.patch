+fn verify_live(home: &Path, market: &Path, meta: &Value, run: &mut dyn FnMut(&[&str])->Result<Value,String>) -> Result<Value,String> {
+    let id=uuid::Uuid::parse_str(meta["vmId"].as_str().ok_or_else(fail)?).map_err(|_|fail())?.simple().to_string();
+    let name=format!("luda-{id}");let market_name=format!("silo-{id}");let server=format!("ld-{id}");
+    if meta["plugin"]!=name || meta["marketplace"]!=market_name || meta["serverName"]!=server {return Err(fail())}
+    let version=meta["version"].as_str().ok_or_else(fail)?;
+    if version.contains('/') || version.contains('\\') || version==".." {return Err(fail())}
+    let plugin_id=format!("{name}@{market_name}");
+    let markets=run(&["plugin","marketplace","list"])?;
+    let matches:Vec<_>=markets["marketplaces"].as_array().ok_or_else(fail)?.iter().filter(|m|m["name"]==market_name).collect();
+    if matches.len()!=1 || matches[0]["marketplaceSource"]!=json!({"sourceType":"local","source":market}) {return Err("Marketplace source changed. Nothing was updated.".into())}
+    let plugins=run(&["plugin","list"])?;
+    let entries:Vec<_>=plugins["installed"].as_array().ok_or_else(fail)?.iter().filter(|p|p["pluginId"]==plugin_id).collect();
+    if entries.len()!=1 || entries[0]["enabled"]!=true || entries[0]["version"]!=version
+       || entries[0]["source"]!=json!({"source":"local","path":market.join("plugins").join(&name)}) {return Err("Installed plugin is disabled, changed or missing. Nothing was updated.".into())}
+    let source=market.join("plugins").join(&name);verify_files(&source,meta)?;
+    let cached=home.join("plugins/cache").join(&market_name).join(&name).join(version);verify_files(&cached,meta)?;
+    let source_manifest=read_json(&source.join(".codex-plugin/plugin.json"))?;
+    let cached_manifest=read_json(&cached.join(".codex-plugin/plugin.json"))?;
+    if source_manifest!=cached_manifest || source_manifest["name"]!=name || source_manifest["version"]!=version {return Err(fail())}
+    let servers=run(&["mcp","list"])?;
+    let rows:Vec<_>=servers.as_array().ok_or_else(fail)?.iter().filter(|p|p["name"]==server).collect();
+    let config=read_json(&source.join(".mcp.json"))?;
+    if rows.len()!=1 || rows[0]["enabled"]!=true {return Err(fail())}
+    let transport=&rows[0]["transport"];
+    if transport["type"]!="stdio" || !transport["cwd"].is_null()
+       || !(transport["env"].is_null() || transport["env"]==json!({}))
+       || !(transport["env_vars"].is_null() || transport["env_vars"]==json!([]))
+       || ["command","args"].iter().any(|key|transport[key]!=config["mcpServers"][&server][key]) {return Err("Effective MCP transport differs. Nothing was updated.".into())}
+    Ok(json!({"plugin":entries[0],"transport":rows[0],"cacheManifest":cached_manifest,"cacheSkill":meta["skillSha256"],"cacheMcp":meta["mcpSha256"]}))
+}
+fn plan_update(home: &Path, market: &Path, context: &Value, skill: &[u8], run: &mut dyn FnMut(&[&str])->Result<Value,String>) -> Result<UpdatePlan,String> {
+    let old=read_json(&market.join("host-registration.json"))?;
+    let live=verify_live(home,market,&old,run)?;
+    let name=old["plugin"].as_str().ok_or_else(fail)?;
+    let receipt=read_json(&home.join("luda-registrations").join(format!("{name}.json")))?;
+    let identity=json!({"pluginId":format!("{}@{}",name,old["marketplace"].as_str().ok_or_else(fail)?),"marketplaceRoot":market,"metadata":old});
+    if receipt["state"]!="registered" || receipt["identity"]!=identity {return Err("Registration requires review before an update.".into())}
+    let plugin=market.join("plugins").join(name);
+    let mcp=read(&plugin.join(".mcp.json"))?;
+    let manifest=read_json(&plugin.join(".codex-plugin/plugin.json"))?;
+    let catalog=read(&market.join(".agents/plugins/marketplace.json"))?;
+    let catalog_value:Value=serde_json::from_slice(&catalog).map_err(|_|fail())?;
+    if catalog_value!=json!({"name":old["marketplace"],"plugins":[{"name":name,"source":{"source":"local","path":format!("./plugins/{name}")},"policy":{"installation":"AVAILABLE","authentication":"ON_INSTALL"},"category":"Productivity"}]}) {return Err("Marketplace catalog changed. Nothing was updated.".into())}
+    let revision=hash(&[mcp.as_slice(),skill].concat());
+    let mut new=old.clone();new["version"]=json!(format!("0.1.0+ssh.{}",&revision[..16]));new["skillSha256"]=json!(hash(skill));
+    if new==old {return Err("This profile already has the reviewed version.".into())}
+    let mut new_manifest=manifest.clone();new_manifest["version"]=new["version"].clone();
+    let transport=market.parent().ok_or_else(fail)?.join("transport");
+    let token=hash(&serde_json::to_vec(&json!({"home":home,"market":market,"context":context,"receipt":receipt,"old":old,"new":new,"live":live,"manifest":manifest,"candidateManifest":new_manifest,"catalog":hash(&catalog),"sshConfig":hash(&read(&transport.join("ssh_config"))?),"knownHosts":hash(&read(&transport.join("known_hosts"))?)})).map_err(|_|fail())?);
+    Ok(UpdatePlan{old,new,token,mcp,manifest:new_manifest,catalog})
+}
+fn apply_update(home: &Path, market: &Path, plan: UpdatePlan, skill: &[u8], run: &mut dyn FnMut(&[&str])->Result<Value,String>) -> Result<Value,String> {
+    let target=market.parent().ok_or_else(fail)?;
+    let stage=tempfile::tempdir_in(target).map_err(|_|fail())?;
+    let name=plan.new["plugin"].as_str().ok_or_else(fail)?;
+    let plugin=stage.path().join("plugins").join(name);
+    fs::create_dir_all(plugin.join(".codex-plugin")).map_err(|_|fail())?;
+    fs::create_dir_all(plugin.join("skills/luda")).map_err(|_|fail())?;
+    fs::create_dir_all(stage.path().join(".agents/plugins")).map_err(|_|fail())?;
+    write(&plugin.join(".mcp.json"),&plan.mcp)?;write(&plugin.join("skills/luda/SKILL.md"),skill)?;
+    write_json(&plugin.join(".codex-plugin/plugin.json"),&plan.manifest)?;
+    write(&stage.path().join(".agents/plugins/marketplace.json"),&plan.catalog)?;
+    write_json(&stage.path().join("host-registration.json"),&plan.new)?;
+    let archive=target.join(format!("previous-{}",plan.token));
+    if archive.exists(){return Err("A previous update needs review. Nothing was retried.".into())}
+    let receipt=home.join("luda-registrations").join(format!("{name}.json"));
+    let identity=|meta:&Value|json!({"pluginId":format!("{}@{}",name,meta["marketplace"].as_str().unwrap_or("")),"marketplaceRoot":market,"metadata":meta});
+    let pending=json!({"state":"update-unconfirmed","identity":identity(&plan.old),"candidateIdentity":identity(&plan.new),"previousBundle":archive});
+    write_json(&receipt,&pending)?;
+    // Keep old source and transport even on publish/CLI failure. Do not attempt
+    // rollback or replay: the CLI may have committed despite a lost response.
+    let publish=fs::rename(market,&archive).and_then(|_|fs::rename(stage.path(),market));
+    let result=|state|json!({"state":state,"vmId":plan.new["vmId"],"serverName":plan.new["serverName"],"runtimeVerified":false});
+    if publish.is_err(){return Ok(result("update-unconfirmed"))}
+    let selector=format!("{}@{}",name,plan.new["marketplace"].as_str().ok_or_else(fail)?);
+    let _ack=run(&["plugin","add",&selector]);
+    if verify_live(home,market,&plan.new,run).is_ok(){
+        write_json(&receipt,&json!({"state":"registered","identity":identity(&plan.new),"previousBundle":archive}))?;
+        Ok(result("updated"))
+    }else{Ok(result("update-unconfirmed"))}
+}
+
+fn confirm_update(home: &Path, market: &Path, plan: UpdatePlan, confirmation: &str, skill: &[u8], run: &mut dyn FnMut(&[&str])->Result<Value,String>) -> Result<Value,String> {
+    if confirmation!=plan.token {return Err("The update preview is stale. Review a fresh preview; nothing was updated.".into())}
+    apply_update(home,market,plan,skill,run)
+}
