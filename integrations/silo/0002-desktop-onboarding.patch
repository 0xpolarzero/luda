+// Install the optional integration assets, then invoke only the existing guest
+// bootstrap wrapper. Desktop startup/viewing does not depend on its result.
+fn agent_tools_script(background: bool) -> String {
+    let mut script = String::from("\nsh -eu <<'SILO_AGENT_TOOLS_SETUP' >/dev/null 2>&1 || true\ninstall -d -m 0755 /usr/local/lib/silo-agent-tools\nagent_stage=$(mktemp -d /usr/local/lib/silo-agent-tools/.stage.XXXXXXXX)\ntrap 'rm -rf \"$agent_stage\"' EXIT\ncat > \"$agent_stage/agent-tools.py\" <<'SILO_AGENT_TOOLS_PY'\n");
+    script.push_str(include_str!("../guest/agent-tools.py"));
+    script.push_str("\nSILO_AGENT_TOOLS_PY\ncat > \"$agent_stage/release.json\" <<'SILO_AGENT_TOOLS_RELEASE'\n");
+    script.push_str(include_str!("../guest/agent-tools-release.json"));
+    script.push_str("\nSILO_AGENT_TOOLS_RELEASE\nchmod 0755 \"$agent_stage/agent-tools.py\"\nchmod 0644 \"$agent_stage/release.json\"\nmv \"$agent_stage/agent-tools.py\" /usr/local/lib/silo-agent-tools/agent-tools.py\nmv \"$agent_stage/release.json\" /usr/local/lib/silo-agent-tools/release.json\n");
+    if background {
+        // The wrapper's nonblocking lock prevents duplicate attempts. Dispatch
+        // alone asserts no success: subsequent status is pending/unconfirmed.
+        script.push_str("nohup python3 /usr/local/lib/silo-agent-tools/agent-tools.py ensure </dev/null >/dev/null 2>&1 &\n");
+    } else {
+        // Creation runs in a temporary guest boot: finish before it stops again.
+        script.push_str("python3 /usr/local/lib/silo-agent-tools/agent-tools.py ensure >/dev/null 2>&1\n");
+    }
+    script.push_str("SILO_AGENT_TOOLS_SETUP\n");
+    script
+}
+
+fn public_agent_tools(value: Value) -> Value {
+    let mut state = value["state"].as_str().filter(|state| matches!(*state,
+        "unconfigured" | "pending" | "ready" | "attention" | "unconfirmed" | "update_available"))
+        .unwrap_or("unconfirmed");
+    if state == "ready" && (value["installation_completed"].as_bool() != Some(true)
+        || value["configuration_generated"].as_bool() != Some(true)
+        || value["last_ready"].as_bool() != Some(true)) {
+        state = "unconfirmed";
+    }
+    let reason = value["reason"].as_str().filter(|reason| matches!(*reason,
+        "desktop_status_unavailable" | "source_preparation_failed" | "bootstrap_failed"
+        | "bootstrap_unconfirmed" | "metadata_unavailable" | "operation_busy"));
+    json!({"state":state,"reason":reason,
+        "installationCompleted":value["installation_completed"].as_bool(),
+        "configurationGenerated":value["configuration_generated"].as_bool().unwrap_or(false),
+        "lastReady":value["last_ready"].as_bool(),
+        "checkedAt":value["checked_at"].as_u64().filter(|value| *value <= 9_999_999_999)})
+}
+
+fn agent_tools_status(runner: &dyn RuntimeRunner, paths: &RuntimePaths, name: &str) -> Value {
+    let output = guest(runner, paths, name,
+        "if [ -f /usr/local/lib/silo-agent-tools/agent-tools.py ]; then python3 /usr/local/lib/silo-agent-tools/agent-tools.py status; else printf '%s\\n' '{\"state\":\"unconfigured\"}'; fi",
+        Duration::from_secs(5), false);
+    let value = output.ok().filter(|text| text.len() <= 65536)
+        .and_then(|text| serde_json::from_str(&text).ok()).unwrap_or(Value::Null);
+    public_agent_tools(value)
+}
