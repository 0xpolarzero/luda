+"""Optional real-Chromium layout/keyboard check; mocks only Tauri invocation.
+Run Vite on loopback, then supply an existing Playwright Python environment and
+Chromium executable. This is component qualification, not native/macOS acceptance.
+"""
+import argparse
+import asyncio
+import json
+from pathlib import Path
+from urllib.parse import urlparse
+from playwright.async_api import async_playwright
+
+MOCK = r'''window.calls=[];window.browseResult=null;window.failNext=false;
+window.__TAURI_INTERNALS__={invoke:async(command,args)=>{
+ window.calls.push({command,args});
+ if(window.failNext){window.failNext=false;throw new Error("Owned test profile unavailable")}
+ const base={vmId:"00000000-0000-0000-0000-000000000001",serverName:"ld-"+"a".repeat(128),runtimeVerified:false};
+ if(command==="choose_desktop_codex_path")return window.browseResult;
+ if(command==="suggest_desktop_codex_paths")return {executables:["/test/codex"],profiles:["/test/profile"]};
+ if(command==="update_desktop_codex")return args.confirmation?{...base,state:"updated"}:{...base,state:"preview",token:"review-token",oldVersion:"0.1.0+old",newVersion:"0.1.0+new",oldSkillSha256:"a".repeat(64),newSkillSha256:"b".repeat(64)};
+ if(command==="recover_desktop_codex")return args.confirmation?{...base,state:"registration-confirmed"}:{...base,state:"recovery-inspection",token:"proof-token",action:"keep-registration",version:"0.1.0",proof:"installed-cache-and-effective-config"};
+ return {...base,state:command==="disconnect_desktop_codex"?"removed":"registered"};
+}};'''
+
+async def main(args):
+    assert urlparse(args.url).hostname in ('127.0.0.1', 'localhost', '::1')
+    output=Path(args.output);output.mkdir(parents=True,exist_ok=True)
+    async with async_playwright() as p:
+        browser=await p.chromium.launch(executable_path=args.chromium,headless=True,args=['--no-sandbox'])
+        page=await browser.new_page();page.set_default_timeout(5000)
+        await page.add_init_script(MOCK)
+        results=[]
+        async def bounds(label):
+            value=await page.evaluate('''({width:innerWidth,scrollWidth:document.documentElement.scrollWidth,
+              visibleButtons:[...document.querySelectorAll('button')].filter(b=>b.checkVisibility()).map(b=>({name:b.getAttribute('aria-label')||b.textContent,left:b.getBoundingClientRect().left,right:b.getBoundingClientRect().right}))})''')
+            assert value['scrollWidth']<=value['width']+1,(label,value)
+            assert all(b['left']>=-1 and b['right']<=value['width']+1 for b in value['visibleButtons']),(label,value)
+            value['case']=label;results.append(value)
+        async def feedback_focus():
+            await page.wait_for_function('document.activeElement?.getAttribute("aria-label")==="Registration feedback"')
+        for width in [360,1280]:
+            await page.set_viewport_size({'width':width,'height':900});await page.goto(args.url)
+            assert await page.evaluate('window.calls.length')==0
+            profile='/Users/test/Profiles/'+'long-profile-name-'*10
+            await page.get_by_role('textbox',name='Codex executable').fill('/Users/test/Applications/Codex.app/Contents/Resources/codex')
+            await page.get_by_role('textbox',name='Codex profile directory').fill(profile)
+            assert not await page.get_by_text('Review update',exact=True).is_visible()
+            await bounds(f'{width}-initial')
+            # Native picker cancellation preserves the selected path.
+            await page.get_by_role('button',name='Browse profile').click()
+            assert await page.get_by_role('textbox',name='Codex profile directory').input_value()==profile
+            await page.get_by_role('button',name='Close',exact=True).focus()
+            expected=['Find installed Codex','Codex executable','Browse executable','Codex profile directory','Browse profile','Register in this profile','Manage existing registration']
+            for name in expected:
+                await page.keyboard.press('Tab')
+                actual=await page.evaluate('document.activeElement.getAttribute("aria-label")||document.activeElement.textContent')
+                assert actual.strip()==name,(name,actual)
+            await page.keyboard.press('Enter')
+            assert await page.get_by_role('button',name='Review update',exact=True).is_visible()
+            await bounds(f'{width}-manage')
+            await page.keyboard.press('Tab');assert await page.get_by_role('button',name='Inspect registration',exact=True).evaluate('(e)=>e===document.activeElement')
+            await page.keyboard.press('Tab');assert await page.get_by_role('button',name='Review update',exact=True).evaluate('(e)=>e===document.activeElement')
+            await page.keyboard.press('Enter');await feedback_focus()
+            assert (await page.evaluate('window.calls.at(-1)'))['args']['confirmation'] is None
+            await page.keyboard.press('Tab');assert await page.evaluate('document.activeElement.textContent')=='Technical details'
+            await page.keyboard.press('Enter');await bounds(f'{width}-hashes')
+            await page.screenshot(path=str(output/f'after-preview-{width}.png'),full_page=True)
+            await page.keyboard.press('Tab');assert await page.get_by_role('button',name='Confirm this update').evaluate('(e)=>e===document.activeElement')
+            await page.keyboard.press('Enter');await feedback_focus()
+            assert (await page.evaluate('window.calls.at(-1)'))['args']['confirmation']=='review-token'
+            await page.screenshot(path=str(output/f'after-{width}.png'),full_page=True)
+            await page.get_by_text('Connection details',exact=True).click();await bounds(f'{width}-result-details')
+            await page.screenshot(path=str(output/f'after-details-{width}.png'),full_page=True)
+            await page.get_by_role('button',name='Review update',exact=True).click();await feedback_focus()
+            await page.get_by_role('button',name='Cancel update',exact=True).click()
+            assert await page.get_by_role('button',name='Review update',exact=True).evaluate('(e)=>e===document.activeElement')
+            await page.get_by_role('button',name='Inspect registration',exact=True).click();await feedback_focus()
+            await page.get_by_role('button',name='Cancel recovery',exact=True).click()
+            assert await page.get_by_role('button',name='Inspect registration',exact=True).evaluate('(e)=>e===document.activeElement')
+            # Editing either selected path invalidates a reviewed mutation.
+            await page.get_by_role('button',name='Review update',exact=True).click();await feedback_focus()
+            await page.get_by_role('textbox',name='Codex profile directory').fill(profile+'-changed')
+            assert await page.get_by_role('button',name='Confirm this update').count()==0
+            await page.get_by_role('button',name='Inspect registration',exact=True).click();await feedback_focus()
+            await page.get_by_role('textbox',name='Codex executable').fill('/different/codex')
+            assert await page.get_by_role('button',name='Keep registration').count()==0
+            # Error is announced and focused; it does not issue an automatic retry.
+            await page.evaluate('window.failNext=true');before=await page.evaluate('window.calls.length')
+            await page.get_by_role('button',name='Register in this profile').click();await feedback_focus()
+            assert await page.get_by_role('alert').inner_text()=='Error: Owned test profile unavailable'
+            assert await page.evaluate('window.calls.length')==before+1
+            await bounds(f'{width}-error')
+            await page.get_by_role('textbox',name='Codex profile directory').fill('/new/profile')
+            assert await page.get_by_role('alert').count()==0
+            assert await page.evaluate('window.calls.length')==before+1
+        (output/'after.json').write_text(json.dumps({'browser':browser.version,'results':results,'scope':'actual React/CSS in Chromium, mocked Tauri only; no native/macOS acceptance'},indent=2)+'\n')
+        await browser.close()
+        print(json.dumps({'passed':True,'layout_cases':len(results),'viewports':[360,1280]}))
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--url',default='http://127.0.0.1:1425/tests/registration-panel/')
+    parser.add_argument('--chromium',required=True)
+    parser.add_argument('--output',required=True)
+    asyncio.run(main(parser.parse_args()))
