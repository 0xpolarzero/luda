+/// Build a candidate without touching the currently registered transport.
+pub(crate) fn stage_private_transport(paths: &RuntimePaths, name: &str, stage: &Path, destination: &Path) -> Result<String, String> {
+    let (alias, config) = prepare_private_transport(paths, name, stage)?;
+    let from = format!("  UserKnownHostsFile {}\n", ssh_quote(&stage.join("known_hosts"))?);
+    let to = format!("  UserKnownHostsFile {}\n", ssh_quote(&destination.join("known_hosts"))?);
+    let text = fs::read_to_string(&config).map_err(|_| FAILED)?;
+    if text.matches(&from).count() != 1 { return Err(FAILED.into()); }
+    write_private(&config, text.replacen(&from, &to, 1).as_bytes())?;
+    Ok(alias)
+}
