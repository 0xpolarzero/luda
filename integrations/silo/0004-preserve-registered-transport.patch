+fn candidate_bundle(target: &Path, id: &str, stage: &Path, alias: &str) -> Result<(PathBuf, Value), String> {
+    let transport = target.join("transport");
+    if transport.exists() {
+        private_dir(&transport)?;
+        for name in ["ssh_config", "known_hosts"] {
+            let path = transport.join(name);
+            if !fs::symlink_metadata(&path).map_err(|_| fail())?.is_file()
+                || read(&path)? != read(&stage.join(name))? {
+                return Err("Existing SSH transport differs. It was preserved; review an explicit update.".into());
+            }
+        }
+    }
+    // Validate the bundle before promoting any candidate transport. Registration
+    // never replaces an existing transport, including on a subsequent CLI conflict.
+    let result = bundle(target, id, &transport.join("ssh_config"), alias)?;
+    if !transport.exists() { fs::rename(stage, &transport).map_err(|_| fail())?; }
+    Ok(result)
+}
