+import { render, screen, waitFor } from "@testing-library/react"
+import userEvent from "@testing-library/user-event"
+import { beforeEach, expect, it, vi } from "vitest"
+import { CodexDesktopRegistration } from "./codex-desktop-registration"
+const invoke = vi.hoisted(() => vi.fn())
+vi.mock("@tauri-apps/api/core", () => ({ invoke }))
+beforeEach(() => invoke.mockReset())
+it("requires explicit paths and submits the selected VM without implying runtime readiness", async () => {
+  invoke.mockResolvedValue({ state: "registered", vmId: "vm-123", serverName: "ld-123", runtimeVerified: false })
+  const user = userEvent.setup()
+  render(<CodexDesktopRegistration workspace="selected-vm" name="Design VM" onClose={() => {}} />)
+  expect(invoke).not.toHaveBeenCalled()
+  expect(screen.getByRole("button", { name: "Register in this profile" })).toBeDisabled()
+  await user.type(screen.getByRole("textbox", { name: "Codex executable" }), "/opt/codex/bin/codex")
+  await user.type(screen.getByRole("textbox", { name: "Codex profile directory" }), "/Users/test/selected-profile")
+  await user.click(screen.getByRole("button", { name: "Register in this profile" }))
+  await waitFor(() => expect(invoke).toHaveBeenCalledExactlyOnceWith("register_desktop_codex", { workspace: "selected-vm", codexExecutable: "/opt/codex/bin/codex", codexHome: "/Users/test/selected-profile" }))
+  expect(await screen.findByRole("status")).toHaveTextContent("Profile registration verified")
+  expect(screen.getByRole("status")).toHaveTextContent("runtime readiness and active conversation discovery were not verified")
+})
+it("keeps partial registration distinct and never retries automatically", async () => {
+  invoke.mockResolvedValue({ state: "unconfirmed", vmId: "vm-123", serverName: "ld-123", runtimeVerified: false })
+  const user = userEvent.setup();render(<CodexDesktopRegistration workspace="selected-vm" name="VM" onClose={() => {}} />)
+  await user.type(screen.getByRole("textbox", { name: "Codex executable" }), "/codex")
+  await user.type(screen.getByRole("textbox", { name: "Codex profile directory" }), "/profile")
+  await user.click(screen.getByRole("button", { name: "Register in this profile" }))
+  expect(await screen.findByRole("status")).toHaveTextContent("Registration is unconfirmed")
+  expect(invoke).toHaveBeenCalledTimes(1)
+})
