+import { useState } from "react"
+import { invoke } from "@tauri-apps/api/core"
+import { z } from "zod"
+import { Button } from "@/components/ui/button"
+
+const resultSchema = z.object({
+  state: z.enum(["registered", "already-registered", "unconfirmed"]),
+  vmId: z.string(), serverName: z.string(), runtimeVerified: z.literal(false),
+})
+
+export function CodexDesktopRegistration({ workspace, name, onClose }: { workspace: string; name: string; onClose: () => void }) {
+  const [executable, setExecutable] = useState("")
+  const [profile, setProfile] = useState("")
+  const [busy, setBusy] = useState(false)
+  const [result, setResult] = useState<z.infer<typeof resultSchema> | null>(null)
+  const [error, setError] = useState<string | null>(null)
+  async function register() {
+    if (busy) return
+    setBusy(true); setError(null); setResult(null)
+    try { setResult(resultSchema.parse(await invoke("register_desktop_codex", { workspace, codexExecutable: executable, codexHome: profile }))) }
+    catch (cause) { setError(String(cause)) }
+    finally { setBusy(false) }
+  }
+  return <section aria-label="Connect desktop tools to Codex" className="grid shrink-0 gap-2 border-b border-border p-3 text-xs">
+    <p>Register desktop tools and the Luda skill for <strong>{name}</strong> in the host Codex profile you select. This supports VMs on this computer.</p>
+    <label className="grid gap-1">Codex executable<input aria-label="Codex executable" value={executable} onChange={event => setExecutable(event.target.value)} disabled={busy} placeholder="Absolute path to the host Codex CLI" className="rounded border p-1" /></label>
+    <label className="grid gap-1">Codex profile directory<input aria-label="Codex profile directory" value={profile} onChange={event => setProfile(event.target.value)} disabled={busy} placeholder="Absolute path to the intended existing Codex profile" className="rounded border p-1" /></label>
+    <p>No default profile is selected. Registering changes only this selected profile; it does not add or select a Codex SSH workspace.</p>
+    <div className="flex gap-2"><Button size="xs" disabled={busy || !executable.startsWith("/") || !profile.startsWith("/")} onClick={() => { void register() }}>{busy ? "Registering…" : "Register in this profile"}</Button><Button size="xs" variant="outline" disabled={busy} onClick={onClose}>Close</Button></div>
+    {error && <p role="alert">{error}</p>}
+    {result && <div role="status">{result.state === "unconfirmed" ? "Registration is unconfirmed. Inspect the selected profile before retrying." : "Profile registration verified. Start a new Codex conversation and verify the intended VM with desktop_doctor and desktop_observe before input."}<p>VM: {result.vmId} · Server: {result.serverName}</p><p>Guest runtime readiness and active conversation discovery were not verified. The Luda skill is generic guidance; use this VM-specific server.</p></div>}
+  </section>
+}
