+fn disconnect_with(home: &Path, market: &Path, meta: &Value, run: &mut dyn FnMut(&[&str]) -> Result<Value, String>) -> Result<Value, String> {
+    let id = uuid::Uuid::parse_str(meta["vmId"].as_str().ok_or_else(fail)?).map_err(|_|fail())?.simple().to_string();
+    let name = format!("luda-{id}");let marketplace = format!("silo-{id}");let server = format!("ld-{id}");
+    if meta["plugin"] != name || meta["marketplace"] != marketplace || meta["serverName"] != server { return Err(fail()); }
+    let plugin_id = format!("{name}@{marketplace}");
+    let receipt = home.join("luda-registrations").join(format!("{name}.json"));
+    let old = read_json(&receipt)?;
+    let identity = json!({"pluginId":plugin_id,"marketplaceRoot":market,"metadata":meta});
+    if old["identity"] != identity { return Err("This profile has no matching owned registration receipt. Nothing was removed.".into()); }
+    let absent = |run: &mut dyn FnMut(&[&str]) -> Result<Value,String>| -> Result<bool,String> {
+        let plugins=run(&["plugin","list"])?;let servers=run(&["mcp","list"])?;
+        Ok(!plugins["installed"].as_array().ok_or_else(fail)?.iter().any(|p|p["pluginId"]==plugin_id)
+           && !servers.as_array().ok_or_else(fail)?.iter().any(|p|p["name"]==server))
+    };
+    let result = |state|json!({"state":state,"vmId":meta["vmId"],"serverName":server,"runtimeVerified":false});
+    if absent(run)? { write_json(&receipt,&json!({"state":"removed","identity":identity}))?;return Ok(result("removed")); }
+    if old["state"] != "registered" { return Err("Previous removal or registration is unconfirmed. Inspect this profile before another explicit operation.".into()); }
+    // Read-only existing-plugin checks (receipt guarantees missing entry cannot
+    // trigger installation). Refuse modified/disabled/overridden registrations.
+    register_with(home,market,meta,run)?;
+    write_json(&receipt,&json!({"state":"removal-pending","identity":identity}))?;
+    let _acknowledgement=run(&["plugin","remove",&plugin_id]);
+    match absent(run) {
+        Ok(true)=>{write_json(&receipt,&json!({"state":"removed","identity":identity}))?;Ok(result("removed"))},
+        _=>{write_json(&receipt,&json!({"state":"removal-unconfirmed","identity":identity}))?;Ok(result("removal-unconfirmed"))}
+    }
+}
