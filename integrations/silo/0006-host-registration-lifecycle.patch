+#[tauri::command]
+pub async fn disconnect_desktop_codex(app: AppHandle, window: tauri::Window, workspace: String, codex_executable: String, codex_home: String) -> Result<Value,String> {
+    crate::desktop_viewer::require_workspace(&window,&workspace)?;
+    tauri::async_runtime::spawn_blocking(move||{
+        crate::runtime::shutdown::ensure_accepting_operations()?;
+        if crate::remote_access::target(&workspace)?.is_some(){return Err("Codex registration currently supports VMs on this computer only.".into())}
+        let executable=owned(Path::new(&codex_executable),false)?;let home=owned(Path::new(&codex_home),true)?;let _lock=profile_lock(&home)?;
+        let (_,machine)=crate::desktop::machine(&app,&workspace)?;
+        let id=uuid::Uuid::parse_str(machine.id()).map_err(|_|fail())?.to_string();
+        let market=home.join("silo-desktop-tools").join(id).join("marketplace");
+        let meta=read_json(&market.join("host-registration.json"))?;
+        if meta["vmId"]!=machine.id(){return Err(fail())}
+        disconnect_with(&home,&market,&meta,&mut|args|cli(&executable,&home,args))
+    }).await.map_err(|_|"Codex disconnect worker failed; inspect the selected profile.".to_string())?
+}
+
+#[tauri::command]
+pub fn suggest_desktop_codex_paths(window: tauri::Window, workspace: String) -> Result<Value,String> {
+    crate::desktop_viewer::require_workspace(&window,&workspace)?;
+    let home=std::env::var_os("HOME").map(PathBuf::from);
+    let mut candidates=Vec::new();
+    if let Some(path)=std::env::var_os("PATH") {candidates.extend(std::env::split_paths(&path).take(64).filter(|p|p.is_absolute()).map(|p|p.join("codex")));}
+    if let Some(home)=&home {candidates.push(home.join(".local/bin/codex"));candidates.push(home.join(".cargo/bin/codex"));}
+    candidates.extend(["/opt/homebrew/bin/codex","/usr/local/bin/codex","/usr/bin/codex"].map(PathBuf::from));
+    let mut executables=Vec::new();
+    for candidate in candidates {if let Ok(path)=owned(&candidate,false) {if !executables.contains(&path) {executables.push(path);}}}
+    let mut profiles=Vec::new();
+    let candidates=std::env::var_os("CODEX_HOME").map(PathBuf::from).into_iter().chain(home.map(|h|h.join(".codex")));
+    for candidate in candidates {if let Ok(path)=owned(&candidate,true) {if !profiles.contains(&path) {profiles.push(path);}}}
+    Ok(json!({"executables":executables,"profiles":profiles}))
+}
+
+#[tauri::command]
+pub async fn choose_desktop_codex_path(app: AppHandle, window: tauri::Window, workspace: String, directory: bool) -> Result<Option<String>,String> {
+    use tauri_plugin_dialog::DialogExt;
+    crate::desktop_viewer::require_workspace(&window,&workspace)?;
+    tauri::async_runtime::spawn_blocking(move||{
+        let dialog=app.dialog().file().set_parent(&window).set_title(if directory {"Choose the intended Codex profile directory"}else{"Choose the Codex executable"});
+        let selected=if directory {dialog.blocking_pick_folder()}else{dialog.blocking_pick_file()};
+        let Some(selected)=selected else{return Ok(None)};
+        let path=selected.into_path().map_err(|_|fail())?;
+        Ok(Some(owned(&fs::canonicalize(path).map_err(|_|fail())?,directory)?.to_str().ok_or_else(fail)?.to_string()))
+    }).await.map_err(|_|"Codex path selection failed.".to_string())?
+}
